GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=

APP_BASE_URL=https://www.mypethealth.co.nz
NEXT_PUBLIC_APP_BASE_URL=https://www.mypethealth.co.nz

SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Customer-approved out-of-stock enquiries. The sender domain must be
# verified in Resend; staff replies go directly to the customer.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Buddy <buddy@mypethealth.co.nz>
RESTOCK_ENQUIRY_TO_EMAIL=admin@allgoodpetfood.co.nz

SHOPIFY_STORE_URL=https://allgoodpetfood.co.nz
SHOPIFY_STOREFRONT_DOMAIN=allgoodpetfood.co.nz
SHOPIFY_STOREFRONT_API_DOMAIN=northland-petfood.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_APP_CLIENT_ID=
SHOPIFY_APP_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_SECRET=
SHOPIFY_CUSTOMER_ACCOUNT_AUTHORIZATION_ENDPOINT=
SHOPIFY_CUSTOMER_ACCOUNT_TOKEN_ENDPOINT=
SHOPIFY_CUSTOMER_ACCOUNT_LOGOUT_ENDPOINT=
SHOPIFY_SESSION_SECRET=
# Optional Shopify page that relaunches Buddy after storefront sign-in.
# Create it from docs/SHOPIFY_BUDDY_LOGIN_HANDOFF.md before enabling this.
SHOPIFY_BUDDY_RETURN_PATH=/

# Local `npm run dev` only. The bypass defaults to enabled in development and
# is hard-disabled in production. Set false to test the real Shopify login.
LOCAL_DEV_AUTH_BYPASS=true
LOCAL_DEV_CUSTOMER_EMAIL=

ADMIN_EMAIL_ADDRESSES=
